LISP> (unwind-protect (+ 1 2) (print 'cleanup))

CLEANUP 
3
LISP> (defvar *log* nil)
*LOG*
LISP> (defun f (x) (unwind-protect (if (> x 0) (throw 'out x) x) (push x *log*)))
F
LISP> (catch 'out (f 5))
5
LISP> (catch 'out (f -1))
-1
LISP> *log*
(-1 5)
LISP> (block b (unwind-protect (return-from b 'early) (push 'block *log*)))
EARLY
LISP> *log*
(BLOCK -1 5)
LISP> (catch 'out (unwind-protect (unwind-protect (throw 'out 1) (push 'inner *log*)) (push 'outer *log*)))
1
LISP> *log*
(OUTER INNER BLOCK -1 5)
LISP> (defvar *s* 'global)
*S*
LISP> (defun g () (let ((*s* 'bound)) (unwind-protect (throw 'out *s*) (push *s* *log*))))
G
LISP> (catch 'out (g))
BOUND
LISP> *log*
(BOUND OUTER INNER BLOCK -1 5)
LISP> *s*
GLOBAL
LISP> (dolist (i '(1 2 3)) (unwind-protect (when (= i 2) (return 'two)) (push i *log*)))
TWO
LISP> *log*
(2 1 BOUND OUTER INNER BLOCK -1 5)
LISP> (unwind-protect (car 5) (push 'error *log*))
Error: not a list: 5
LISP> *log*
(2 1 BOUND OUTER INNER BLOCK -1 5)
LISP> (pprint '(unwind-protect (progn (open-it) (use-it)) (close-it) (say-so)))

(UNWIND-PROTECT (PROGN
                  (OPEN-IT)
                  (USE-IT))
  (CLOSE-IT)
  (SAY-SO))
NIL
LISP> 