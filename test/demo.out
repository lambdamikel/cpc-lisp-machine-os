LISP> (macroexpand-1 '(do ((a 1 (+ a b)) (b 2 a)) ((> a 5) a)))
(LET ((A 1) (B 2)) (LOOP (WHEN (> A 5) (RETURN (PROGN A))) (LET ((G7 (+ A B)) (G8 A)) (SETQ A G7 B G8))))
