LISP> (with-output-to-string (s) (princ "hello " s) (prin1 'world s) (terpri s) (format s "~D+~D" 1 2))
"hello WORLD
1+2"
LISP> (with-output-to-string (*standard-output*) (print 'x) (princ "y") (format t "~A" 'z))
"
X yZ"
LISP> *standard-output*
NIL
LISP> (let ((s (make-string-output-stream))) (write-string "ab" s) (write-char #\c s) (list (get-output-stream-string s) (get-output-stream-string s)))
("abc" "")
LISP> (with-input-from-string (s "(1 2) foo \"bar\" 42") (list (read s) (read s) (read s) (read s) (read s nil :end)))
((1 2) FOO "bar" 42 :END)
LISP> (with-input-from-string (s "line one
  line two") (list (read-line s) (read-line s) (read-line s nil :eof)))
("line one" " line two" :EOF)
LISP> (with-input-from-string (s "abc") (list (read-char s) (peek-char nil s) (read-char s) (progn (unread-char #\b s) (read-char s)) (read-char s) (read-char s nil :e) (listen s)))
(#\a #\b #\b #\b #\c :E NIL)
LISP> (with-input-from-string (s "x y") (read s) (with-input-from-string (t2 "inner") (read t2)))
INNER
LISP> (with-input-from-string (s "abc def") (read s) (read-line s))
" def"
LISP> (mapcar #'streamp (list (make-string-output-stream) (make-string-input-stream "a") 5))
(T T NIL)
LISP> (list (input-stream-p (make-string-input-stream "a")) (output-stream-p (make-string-output-stream)) (open-stream-p (make-string-output-stream)))
(T T T)
LISP> (read (make-string-output-stream))
Error: the stream is not open #S(STRING-OUTPUT-STREAM NIL)
LISP> (print 1 (make-string-input-stream "a"))
Error: the stream is not open #S(STRING-INPUT-STREAM "a" 0)
LISP> (with-output-to-string (s) (pprint '(defun f (x) (list x x)) s))
"
(DEFUN F (X) (LIST X X))"
LISP> (format nil "[~A]" (with-output-to-string (s) (dotimes (i 5) (format s "~D," i))))
"[0,1,2,3,4,]"
