LISP> (load "meval")
T
LISP> (meval-demo)
(DEFINE FACT (LAMBDA (N) (IF (< N 2) 1 (* N (FACT (- N 1))))))
  => FACT
(FACT 7)
  => 5040
(DEFINE MAKE-ADDER (LAMBDA (N) (LAMBDA (X) (+ X N))))
  => MAKE-ADDER
((MAKE-ADDER 3) 4)
  => 7
(DEFINE MAP (LAMBDA (F L) (IF (NULL? L) NIL (CONS (F (CAR L)) (MAP F (CDR L))))))
  => MAP
(MAP (MAKE-ADDER 10) (LIST 1 2 3))
  => (11 12 13)
