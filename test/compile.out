LISP> (defmacro my-while (test &body body) `(%loop (unless ,test (return)) ,@body))
MY-WHILE
LISP> (defun countdown (n) (let ((r nil)) (my-while (> n 0) (push n r) (decf n)) r))
COUNTDOWN
LISP> (compile 'countdown)
COUNTDOWN
LISP> (countdown 5)
(1 2 3 4 5)
