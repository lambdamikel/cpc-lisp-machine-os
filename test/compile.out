LISP> (defun f6 () (let ((n 0)) (list #'(lambda () (incf n)) #'(lambda () n))))
F6
LISP> (compile 'f6)
F6
LISP> (setq p (f6))
(#<FUNCTION> #<FUNCTION>)
LISP> (list (funcall (car p)) (funcall (car p)) (funcall (cadr p)))
(1 2 2)
