LISP> (defun f1 (a b) (let ((c (* a b)) (d 2)) (list a b c d)))
F1
LISP> (compile 'f1)
F1
LISP> (f1 3 4)
(3 4 12 2)
LISP> (defun f2 (n) (let* ((x n) (y (+ x 1))) (cond ((= x 0) 'zero) ((< x 0) 'neg) (t y))))
F2
LISP> (compile 'f2)
F2
LISP> (list (f2 0) (f2 -3) (f2 5))
(ZERO NEG 6)
LISP> (defun f3 (l) (let ((s 0)) (dolist (x l s) (setq s (+ s x)))))
F3
LISP> (compile 'f3)
F3
LISP> (f3 '(1 2 3 4))
10
LISP> (defun f4 (n) (let ((r nil)) (dotimes (i n) (push i r)) r))
F4
LISP> (compile 'f4)
F4
LISP> (f4 5)
(4 3 2 1 0)
LISP> (defun f5 (k l) (mapcar #'(lambda (x) (* x k)) l))
F5
LISP> (compile 'f5)
F5
LISP> (f5 3 '(1 2 3))
