LISP> (defstruct pt x y)
PT
LISP> (defvar *p* (make-pt :x 1 :y 2))
*P*
LISP> (defvar *ps* (list (make-pt :x 3 :y 4) #(5 6)))
*PS*
LISP> (save "pt" '*p* '*ps*)
(*P* *PS*)
LISP> (makunbound '*p*)
*P*
LISP> (makunbound '*ps*)
*PS*
LISP> (load "pt")
T
LISP> (pt-y *p*)
2
LISP> *ps*
(#S(PT 3 4) #(5 6))
LISP> (pt-x (car *ps*))
3
LISP> (read-from-string "#s(pt 7 8)")
#S(PT 7 8)
LISP> (pt-p (read-from-string "#S(PT 7 8)"))
T
LISP> (read-from-string "#S7")
Error: syntax error
LISP> 