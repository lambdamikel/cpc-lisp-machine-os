(defun tree (d) (if (= d 0) nil (cons (tree (- d 1)) (tree (- d 1)))))
(defun count-tree (tr) (if (null tr) 1 (+ (count-tree (car tr)) (count-tree (cdr tr)))))
(count-tree (tree 10))
(dotimes (k 4) (count-tree (tree 10)))
