NIL
LISP> (fmakunbound 'sq)
SQ
LISP> (fmakunbound 'twice)
TWICE
LISP> (makunbound '*items*)
*ITEMS*
LISP> (fmakunbound 'test)
TEST
LISP> (load "work")
T
LISP> (sq 9)
81
LISP> (test 21)
42
LISP> *items*
(1 "two" #\3)
LISP> (macroexpand-1 '(twice (print 1)))
(PROGN (PRINT 1) (PRINT 1))
LISP> (save "two.lsp" 'sq)
(SQ)
