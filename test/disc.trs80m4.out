LISP> (save "empty")
Error: nothing to save
LISP> (defun sq (x) (* x x))
SQ
LISP> (defvar *items* '(1 "two" #\3))
*ITEMS*
LISP> (defmacro twice (x) `(progn ,x ,x))
TWICE
LISP> (defun test (x) (+ x x))
TEST
LISP> (remove 3 '(1 2 3))
(1 2)
LISP> *features*
(:TRS-80 :MODEL-4 :CPC-LISP)
LISP> (save "work")
(SQ TEST TWICE *ITEMS*)
LISP> (dir)
Drive 0:
