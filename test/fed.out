LISP> (defun fact (n) (if (= n 0) 1 (* n (fact (- n 1)))))
FACT
LISP> (pprint '(defun fact (n) (if (= n 0) 1 (* n (fact (- n 1))))))

(DEFUN FACT (N)
  (IF (= N 0) 1 (* N (FACT (- N 1)))))
NIL
LISP> (pprint '(let ((alpha 1) (beta 2) (gamma 3)) (when (> alpha 0) (print alpha) (print beta)) (list alpha beta gamma 'some-long-symbol-name)))

(LET ((ALPHA 1) (BETA 2) (GAMMA 3))
  (WHEN (> ALPHA 0)
    (PRINT ALPHA)
    (PRINT BETA))
  (LIST ALPHA
        BETA
        GAMMA
        'SOME-LONG-SYMBOL-NAME))
NIL
