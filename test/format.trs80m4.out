LISP> (format nil "Hello, ~a!" "World")
"Hello, World!"
LISP> (format nil "~s and ~a" "str" "str")
"\"str\" and str"
LISP> (format nil "~d + ~d = ~d" 2 3 (+ 2 3))
"2 + 3 = 5"
LISP> (format nil "~a~%~a" 1 2)
"1
2"
LISP> (format nil "100~~ ~c" #\x)
"100~ x"
LISP> (format nil "[~5d]" 42)
"[   42]"
LISP> (format nil "[~8a]" 'abc)
"[ABC     ]"
LISP> (format nil "[~2a]" "toolong")
"[toolong]"
LISP> (format nil "~&start")
"start"
LISP> (format nil "x~&y")
"x
y"
LISP> (format t "~a squared is ~a~%" 7 49)
7 squared is 49
NIL
LISP> (format t "pi is about ~a" pi)
pi is about 3.14159265
NIL
LISP> (format nil "~a" '(1 "two" #\3 4.5))
"(1 two 3 4.5)"
LISP> (format nil "~s" '(1 "two" #\3 4.5))
"(1 \"two\" #\\3 4.5)"
LISP> (format nil "~a ~a" 1)
Error: too few arguments
LISP> (format nil "~q" 1)
Error: bad format directive
LISP> (format nil "abc~")
Error: bad format directive
LISP> (format nil 42)
Error: not a string: 42
LISP> (dotimes (i 3) (format t "~3d~6d~%" i (* i i i)))
  0     0
  1     1
  2     8
NIL
LISP> (princ "line1
  line2")
line1
line2
"line1
line2"
LISP> (format nil "~A|~S|~5A|~5@A|~:A" "ab" "ab" 'x 'y nil)
"ab|\"ab\"|X    |    Y|()"
LISP> (format nil "~D ~5D ~5,'0D ~@D ~:D ~B ~O ~X ~16R" 42 42 42 42 12345 10 64 255 255)
"42    42 00042 +42 12,345 1010 100 FF FF"
LISP> (format nil "~D ~D ~:D ~D" 40000.0 -2.5 1234567.0 0.0)
"40000 -2.5 1,234,567 0"
LISP> (format nil "~R|~:R|~@R|~:@R" 1984 1984 1984 4)
"one thousand nine hundred eighty-four|one thousand nine hundred eighty-fourth|MCMLXXXIV|IIII"
LISP> (format nil "~R ~R ~R ~:R ~:R ~:R ~:R" 0 13 -105 1 12 20 1000)
"zero thirteen negative one hundred five first twelfth twentieth one thousandth"
LISP> (format nil "~R" 16383)
"sixteen thousand three hundred eighty-three"
LISP> (format nil "~,2F|~8,3F|~F|~F|~,0F|~@F" 3.14159 2.5 7 1.5 2.5 1)
"3.14|   2.500|7.0|1.5|3.|+1.0"
LISP> (format nil "~,2F ~,2F ~,1F ~,3F ~$ ~$" 9.996 -0.001 0.05 1234.5678 3.14159 100)
"10.00 -0.00 0.1 1234.568 3.14 100.00"
LISP> (format nil "~D item~:P, ~D item~:P, ~D pon~:@P ~D pon~:@P" 1 2 1 3)
"1 item, 2 items, 1 pony 3 ponies"
LISP> (format nil "~{~A~^, ~}" '(a b c))
"A, B, C"
LISP> (format nil "~{~A=~A~^ ~}" '(x 1 y 2))
"X=1 Y=2"
LISP> (format nil "~:{(~A ~A)~}" '((a 1) (b 2)))
"(A 1)(B 2)"
LISP> (format nil "~@{~A~^-~}" 1 2 3)
"1-2-3"
LISP> (format nil "~2{~A~}" '(1 2 3 4))
