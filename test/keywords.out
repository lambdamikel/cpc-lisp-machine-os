LISP> (find 3 '(1 2 3 4 3))
3
LISP> (find 3 '(1 2 3 4 3) :from-end t)
3
LISP> (position 3 '(1 2 3 4 3))
2
LISP> (position 3 '(1 2 3 4 3) :from-end t)
4
LISP> (position 3 '(1 2 3 4 3) :start 3)
4
LISP> (position 3 '(1 2 3 4 3) :end 2)
NIL
LISP> (position #\a "banana" :start 2)
3
LISP> (position #\a "banana" :from-end t)
5
LISP> (position #\a "banana" :start 1 :end 3)
1
LISP> (count #\a "banana" :start 2)
2
LISP> (count 1 '(1 1 1 1) :end 2)
2
LISP> (remove 1 '(1 2 1 3 1) :count 2)
(2 3 1)
LISP> (remove 1 '(1 2 1 3 1) :count 2 :from-end t)
(1 2 3)
LISP> (remove 1 '(1 2 1 3 1) :start 1)
(1 2 3)
LISP> (remove 1 '(1 2 1 3 1) :start 1 :end 3)
(1 2 3 1)
LISP> (remove #\a "banana" :count 1 :from-end t)
"banan"
LISP> (remove-if #'evenp (vector 1 2 3 4 5) :start 2)
#(1 2 3 5)
LISP> (substitute 0 1 '(1 2 1 3 1) :count 2 :from-end t)
(1 2 0 3 0)
LISP> (substitute #\o #\a "banana" :start 3)
"banono"
LISP> (substitute-if 0 #'oddp '(1 2 3))
(0 2 0)
LISP> (substitute-if-not 0 #'oddp '(1 2 3))
(1 0 3)
LISP> (find-if #'evenp '(1 3 4 5 6) :from-end t)
6
LISP> (find-if-not #'evenp '(2 4 5 6))
5
LISP> (position-if #'upper-case-p "abCdE" :from-end t)
4
LISP> (count-if-not #'evenp '(1 2 3))
2
LISP> (find 'b '((a 1) (b 2)) :key #'car)
(B 2)
LISP> (find 2 '((a 1) (b 2)) :key #'cadr :test #'=)
(B 2)
LISP> (remove "b" '("a" "b" "c") :test #'string=)
("a" "c")
LISP> (remove "b" '("a" "b" "c") :test-not #'string=)
("b")
LISP> (position 2 '(1 2 3) :test-not #'eql)
0
LISP> (find nil '(1 nil 2))
NIL
LISP> (position nil '(1 nil 2))
1
LISP> (remove-duplicates '(1 2 1 3 2))
(1 3 2)
LISP> (remove-duplicates "hello")
"helo"
LISP> (remove-duplicates '((a 1) (b 2) (a 3)) :key #'car)
((B 2) (A 3))
LISP> (remove-duplicates '("a" "A" "b") :test #'string-equal)
("A" "b")
LISP> (delete 1 (list 1 2 1))
(2)
LISP> (nsubstitute 9 1 (list 1 2))
(9 2)
LISP> (count 1 nil)
0
LISP> (remove 1 "")
""
LISP> (find 1 5)
Error: not a sequence: 5
LISP> (position 1 '(1) :start 'x)
Error: not a number: X
LISP> (remove 3 (vector 1 3 2 3))
#(1 2)
LISP> (count #\a "banana")
3
LISP> 