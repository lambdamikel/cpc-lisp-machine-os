LISP> (defstruct point x (y 0))
POINT
LISP> (setq p (make-point :x 3))
#S(POINT 3 0)
LISP> (point-x p)
3
LISP> (point-y p)
0
LISP> (setf (point-y p) 7)
7
LISP> p
#S(POINT 3 7)
LISP> (point-p p)
T
LISP> (point-p 5)
NIL
LISP> (copy-point p)
#S(POINT 3 7)
LISP> (eq p (copy-point p))
NIL
LISP> (type-of p)
POINT
LISP> (typep p 'point)
T
LISP> (typep 3 'integer)
T
LISP> (point-x 5)
Error: not the structure it should be: 5
