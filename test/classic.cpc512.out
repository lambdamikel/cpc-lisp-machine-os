T
LISP> (deriv-demo)
d/dx (+ (* 3 (^ X 2)) (* 2 X) 1)
   = (+ (* 6 X) 2)
d/dx (* X (SIN X))
   = (+ (* X (COS X)) (SIN X))
d/dx (/ 1 X)
   = (/ -1 (^ X 2))
d/dx (EXP (* 2 X))
   = (* 2 (EXP (* 2 X)))
d/dx (LOG (^ X 2))
   = (/ (* 2 X) (^ X 2))
d/dx (SIN (COS X))
   = (* (COS (COS X)) (* -1 (SIN X)))
d/dx (* (+ X 1) (- X 1))
   = (+ (+ X 1) (- X 1))
NIL
