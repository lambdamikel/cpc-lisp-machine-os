(defun sq (x) (* x x))
(defun sumsq (l) (let ((s 0)) (dolist (x l s) (incf s (sq x)))))
(defmacro twice (x) `(* 2 ,x))
(defun tw (n) (twice n))
(defun greet (who) (format nil "hello, ~A!" who))
(defun adder (n) #'(lambda (x) (+ x n)))
(save "src")
(compile-file "src")
(fmakunbound 'sq)
(fmakunbound 'sumsq)
(fmakunbound 'tw)
(fmakunbound 'greet)
(fmakunbound 'adder)
(load "src.fas")
(sumsq '(1 2 3))
(tw 21)
(greet "CPC")
(funcall (adder 5) 10)
(disassemble 'sq)
