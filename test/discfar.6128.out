LISP> (defvar a (make-far-array "table" 1000))
A
LISP> a
#S(FAR-ARRAY "M:TABLE.FAR" 0 0)
LISP> (far-length a)
1000
LISP> (far-ref a 0)
NIL
LISP> (setf (far-ref a 0) 123)
123
LISP> (setf (far-ref a 999) #\x)
#\x
LISP> (setf (far-ref a 500) t)
T
LISP> (list (far-ref a 0) (far-ref a 999) (far-ref a 500) (far-ref a 1))
(123 #\x T NIL)
LISP> (far-ref a 1000)
Error: index out of range 1000
LISP> (far-ref a -1)
Error: index out of range -1
LISP> (setf (far-ref a 2) "no")
Error: a far array cannot hold: "no"
LISP> (dotimes (i 1000) (setf (far-ref a i) (* i 3)))
NIL
LISP> (let ((s 0)) (dotimes (i 1000) (incf s (far-ref a i))) s)
1498500.0
LISP> (defvar b (make-far-array "m:bytes" 40000 :element-type '(unsigned-byte 8)))
B
LISP> (far-length b)
40000.0
LISP> (setf (far-ref b 39999) 255)
255
LISP> (list (far-ref b 39999) (far-ref b 39998))
(255 0)
LISP> (setf (far-ref b 1) 256)
Error: a far array cannot hold: 256
LISP> (setf (far-ref b 20000) 65)
65
LISP> (with-open-file (s "m:bytes.far") (list (file-position s 20002) (read-char s)))
(T #\A)
LISP> (defvar c (make-far-array "chars" 10 :element-type 'character))
C
LISP> (setf (far-ref c 3) #\A)
#\A
LISP> (list (far-ref c 3) (far-ref c 0) (far-length c))
(#\A #\Nul 10)
LISP> (dir "m:")

Drive M: (RAM)

TABLE.FAR     2002
BYTES.FAR     40002
CHARS.FAR     12

22496 bytes free
NIL
LISP> (save "m:other")
(C B A)
LISP> (delete-file "m:table.far")
T
LISP> (list (far-ref b 39999) (far-ref c 3))
(255 #\A)
LISP> (far-ref a 0)
Error: no such far array: #S(FAR-ARRAY "M:TABLE.FAR" 0 0)
LISP> (far-ref (far-array "bytes") 39999)
255
LISP> (far-array "nothere")
Error: no far array M:NOTHERE.FAR
LISP> (make-far-array "b:x" 10)
Error: far arrays are on M:
LISP> (make-far-array "x" 10 :element-type 'float)
Error: no far array of FLOAT
LISP> (far-ref '(1 2) 0)
Error: not the structure it should be: (1 2)
LISP> (far-length (make-far-array "huge" 65000))
Error: no room on M: for M:HUGE.FAR
