TWICE
LISP> (defun test (x) (+ x x))
TEST
LISP> (remove 3 '(1 2 3))
(1 2)
LISP> *features*
(:CPC :CPC-LISP)
LISP> (save "work")
(SQ TEST TWICE *ITEMS*)
