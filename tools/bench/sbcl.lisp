(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(defun tak (x y z)
  (if (not (< y x)) z
      (tak (tak (1- x) y z) (tak (1- y) z x) (tak (1- z) x y))))
(defun dv-aux (a) (list '/ (dv a) a))
(defun dv (a)
  (cond ((atom a) (if (eq a 'x) 1 0))
        ((eq (car a) '+) (cons '+ (mapcar #'dv (cdr a))))
        ((eq (car a) '-) (cons '- (mapcar #'dv (cdr a))))
        ((eq (car a) '*) (list '* a (cons '+ (mapcar #'dv-aux (cdr a)))))
        ((eq (car a) '/) (list '- (list '/ (dv (cadr a)) (caddr a))
                               (list '/ (cadr a) (list '* (caddr a) (caddr a) (dv (caddr a))))))
        (t 'error)))
(defun dv-run (n)
  (dotimes (i n 'done) (dv '(+ (* 3 x x) (* a x x) (* b x) 5))))
(defun timeit (name thunk reps)
  (funcall thunk)
  (let ((t0 (get-internal-real-time)))
    (dotimes (i reps) (funcall thunk))
    (format t "~a ~a: ~,6f s~%" (if (eq sb-ext:*evaluator-mode* :interpret) "interpreted" "compiled")
            name (/ (- (get-internal-real-time) t0) internal-time-units-per-second reps))))
(let ((k (if (eq sb-ext:*evaluator-mode* :interpret) 1 100)))
  (timeit "(fib 20)" (lambda () (fib 20)) (* k 10))
  (timeit "(tak 18 12 6)" (lambda () (tak 18 12 6)) (* k 3))
  (timeit "(dv-run 100)" (lambda () (dv-run 100)) (* k 50)))
