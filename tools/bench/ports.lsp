; The ports compared (tools/bench/ports.py types this at each one): each
; benchmark timed by the Lisp's own clock, (time), in 1/300 s, a run of
; it at a time -- (time) wraps every 54.6 s, so no run may take longer on
; the slowest machine. "BENCH name ticks" lines are the result.
(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(defun tak (x y z)
(if (not (< y x)) z
(tak (tak (1- x) y z) (tak (1- y) z x) (tak (1- z) x y))))
(defun dv-aux (a) (list '/ (dv a) a))
(defun dv (a)
(cond ((atom a) (if (eq a 'x) 1 0))
((eq (car a) '+) (cons '+ (mapcar #'dv (cdr a))))
((eq (car a) '-) (cons '- (mapcar #'dv (cdr a))))
((eq (car a) '*) (list '* a (cons '+ (mapcar #'dv-aux (cdr a)))))
((eq (car a) '/) (list '- (list '/ (dv (cadr a)) (caddr a))
(list '/ (cadr a) (list '* (caddr a) (caddr a) (dv (caddr a))))))
(t 'error)))
(defun dv-run (n)
(dotimes (i n 'done) (dv '(+ (* 3 x x) (* a x x) (* b x) 5))))
(defun text (n)
(dotimes (i n) (princ "The quick brown fox jumps over the dog") (terpri)))
(defun lines (n)
(dotimes (i n) (move 0 (* i 4)) (draw 639 (- 399 (* i 4)))))
(defmacro bench (name reps form)
`(let ((ticks 0))
(dotimes (k ,reps)
(let ((t0 (time))) ,form (incf ticks (mod (- (time) t0) 16384))))
(format t "BENCH ~(~a~) ~a~%" ',name ticks)))
;@include examples/torus.lsp
(bench fib-i 2 (fib 17))
(bench tak-i 1 (tak 14 8 4))
(bench deriv-i 2 (dv-run 100))
(cls)
(bench text 1 (text 50))
(cls)
(bench lines 1 (lines 100))
(torus)
;@compiled
(compile 'fib)
(compile 'tak)
(compile 'dv)
(compile 'dv-aux)
(compile 'dv-run)
(bench fib-c 1 (fib 20))
(bench tak-c 2 (tak 15 10 5))
(bench deriv-c 3 (dv-run 100))
